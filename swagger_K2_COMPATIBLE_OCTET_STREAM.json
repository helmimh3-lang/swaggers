{
  "swagger": "2.0",
  "info": {
    "title": "SharePoint Opinion Document Management API - K2 Compatible",
    "version": "3.0.0",
    "description": "Microsoft Graph API integration - K2 5.9 Compatible: Using formData with type: file for proper K2 handling"
  },
  "host": "graph.microsoft.com",
  "schemes": [
    "https"
  ],
  "basePath": "/v1.0",
  "consumes": [
    "application/octet-stream"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/oauth2/v2.0/token": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Acquire OAuth 2.0 Access Token",
        "description": "Retrieve access token using Client Credentials flow for subsequent API calls",
        "consumes": [
          "application/x-www-form-urlencoded"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "client_id",
            "in": "formData",
            "description": "Azure AD Application Client ID",
            "required": true,
            "type": "string",
            "default": "1a7702a9-7dcf-4fe2-abb2-ab4e20f8000e"
          },
          {
            "name": "scope",
            "in": "formData",
            "description": "OAuth 2.0 scope",
            "required": true,
            "type": "string",
            "default": "https://graph.microsoft.com/.default"
          },
          {
            "name": "grant_type",
            "in": "formData",
            "description": "Grant type for Client Credentials flow",
            "required": true,
            "type": "string",
            "default": "client_credentials"
          },
          {
            "name": "client_secret",
            "in": "formData",
            "description": "Azure AD Application Client Secret",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Token acquired successfully",
            "schema": {
              "$ref": "#/definitions/TokenResponse"
            }
          },
          "400": {
            "description": "Invalid request parameters"
          },
          "401": {
            "description": "Authentication failed"
          }
        }
      }
    },
    "/drives/b!sSUAtvCgMUm0BFEnFxD3h0sY36Mn1aJLiFrVVaoXUhIzGqL5TbOMQ6oDs5ryvI_X/root:/{fileName}:/content": {
      "put": {
        "tags": [
          "DraftArea"
        ],
        "summary": "Upload Document to DraftArea Library",
        "description": "Upload a document file to the DraftArea library in SharePoint - K2 Compatible",
        "consumes": [
          "application/octet-stream"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "fileName",
            "in": "path",
            "description": "Name of the file to upload (e.g., Minuta_Meeting_20260313.docx)",
            "required": true,
            "type": "string"
          },
          {
            "name": "Authorization",
            "in": "header",
            "description": "Bearer token from OAuth 2.0 token endpoint",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "formData",
            "description": "Binary file content - K2 compatible file upload",
            "required": true,
            "type": "file"
          }
        ],
        "responses": {
          "201": {
            "description": "File uploaded successfully",
            "schema": {
              "$ref": "#/definitions/DriveItemResponse"
            }
          },
          "200": {
            "description": "File uploaded successfully (existing file updated)",
            "schema": {
              "$ref": "#/definitions/DriveItemResponse"
            }
          },
          "400": {
            "description": "Invalid file or request parameters"
          },
          "401": {
            "description": "Unauthorized - invalid or expired token"
          },
          "413": {
            "description": "File too large"
          }
        }
      }
    },
    "/drives/b!sSUAtvCgMUm0BFEnFxD3h0sY36Mn1aJLiFrVVaoXUhJQzYnyN30XRrhXWAL8pDob/root:/{fileName}:/content": {
      "put": {
        "tags": [
          "Opinion"
        ],
        "summary": "Upload Document to Opinion Library",
        "description": "Upload a finalized opinion document to the Opinion library in SharePoint - K2 Compatible",
        "consumes": [
          "application/octet-stream"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "fileName",
            "in": "path",
            "description": "Name of the file to upload",
            "required": true,
            "type": "string"
          },
          {
            "name": "Authorization",
            "in": "header",
            "description": "Bearer token from OAuth 2.0 token endpoint",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "formData",
            "description": "Binary file content - K2 compatible file upload",
            "required": true,
            "type": "file"
          }
        ],
        "responses": {
          "201": {
            "description": "File uploaded successfully",
            "schema": {
              "$ref": "#/definitions/DriveItemResponse"
            }
          },
          "200": {
            "description": "File uploaded successfully (existing file updated)",
            "schema": {
              "$ref": "#/definitions/DriveItemResponse"
            }
          },
          "400": {
            "description": "Invalid file or request parameters"
          },
          "401": {
            "description": "Unauthorized - invalid or expired token"
          },
          "413": {
            "description": "File too large"
          }
        }
      }
    },
    "/drives/b!sSUAtvCgMUm0BFEnFxD3h0sY36Mn1aJLiFrVVaoXUhIzGqL5TbOMQ6oDs5ryvI_X/items/{driveItemId}/listItem/fields": {
      "patch": {
        "tags": [
          "DraftArea"
        ],
        "summary": "Update Document Metadata in DraftArea Library",
        "description": "Update metadata fields for a document in the DraftArea library",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "driveItemId",
            "in": "path",
            "description": "Drive Item ID returned from file upload",
            "required": true,
            "type": "string"
          },
          {
            "name": "Authorization",
            "in": "header",
            "description": "Bearer token from OAuth 2.0 token endpoint",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "description": "Metadata fields to update",
            "required": true,
            "schema": {
              "$ref": "#/definitions/MetadataUpdateRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Metadata updated successfully",
            "schema": {
              "$ref": "#/definitions/MetadataUpdateResponse"
            }
          },
          "400": {
            "description": "Invalid metadata or request parameters"
          },
          "401": {
            "description": "Unauthorized - invalid or expired token"
          },
          "404": {
            "description": "Drive item not found"
          }
        }
      }
    },
    "/drives/b!sSUAtvCgMUm0BFEnFxD3h0sY36Mn1aJLiFrVVaoXUhJQzYnyN30XRrhXWAL8pDob/items/{driveItemId}/listItem/fields": {
      "patch": {
