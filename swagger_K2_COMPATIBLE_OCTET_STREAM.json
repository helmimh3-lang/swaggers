    },
    "/sites/resources.deloitte.com,b60025b1-a0f0-4931-b404-51271710f787,a3df184b-d527-4ba2-885a-d555aa175212/lists/a888ef5f-f49e-4d10-aaf3-3c620e7720d6/items": {
      "post": {
        "tags": [
          "AssistantTickets"
        ],
        "summary": "Create Ticket in AssistantTickets List",
        "description": "Create a new ticket/item in the AssistantTickets SharePoint list",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "description": "Bearer token from OAuth 2.0 token endpoint",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "description": "Ticket fields wrapped in 'fields' object",
            "required": true,
            "schema": {
              "$ref": "#/definitions/TicketCreateRequest"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Ticket created successfully",
            "schema": {
              "$ref": "#/definitions/TicketCreateResponse"
            }
          },
          "400": {
            "description": "Invalid ticket data or request parameters"
          },
          "401": {
            "description": "Unauthorized - invalid or expired token"
          }
        }
      }
    }
  },
  "definitions": {
    "TokenResponse": {
      "type": "object",
      "properties": {
        "token_type": {
          "type": "string",
          "example": "Bearer"
        },
        "expires_in": {
          "type": "integer",
          "format": "int32",
          "example": 3599
        },
        "ext_expires_in": {
          "type": "integer",
          "format": "int32",
          "example": 3599
        },
        "access_token": {
          "type": "string",
          "description": "JWT access token for subsequent API calls",
          "example": "eyJ0eXAiOiJKV1Qi..."
        }
      }
    },
    "DriveItemResponse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique Drive Item ID",
          "example": "01U22VFG6ISPLIRDIPBNGLATE6HN2Y72AQ"
        },
        "name": {
          "type": "string",
          "description": "File name",
          "example": "Minuta_Meeting_20260313.docx"
        },
        "webUrl": {
          "type": "string",
          "description": "Direct URL to the file in SharePoint",
          "example": "https://resources.deloitte.com/sites/DOL-c-IT-AeA-NpdTools/toolopinion/_layouts/15/Doc.aspx?..."
        },
        "size": {
          "type": "integer",
          "format": "int64",
          "description": "File size in bytes",
          "example": 44209
        },
        "createdDateTime": {
          "type": "string",
          "format": "date-time",
          "description": "File creation timestamp",
          "example": "2026-04-24T12:33:11Z"
        }
      }
    },
    "MetadataUpdateRequest": {
      "type": "object",
      "properties": {
        "FY": {
          "type": "string",
          "example": "2026"
        },
        "GMDMID": {
          "type": "string",
          "example": "G0001112223"
        },
        "ClientName": {
          "type": "string",
          "example": "Contoso S.p.A."
        },
        "OpportunityID": {
          "type": "string",
          "example": "OPP-98765"
        },
        "EngPartner": {
          "type": "string",
          "example": "partner@deloitte.it"
        },
        "EngManager": {
          "type": "string",
          "example": "manager@deloitte.it"
        },
        "DataBilancio": {
          "type": "string",
          "format": "date",
          "example": "2025-12-31"
        },
        "DataEmissione": {
          "type": "string",
          "format": "date",
          "example": "2026-03-15"
        },
        "Requestor": {
          "type": "string",
          "example": "requestor@deloitte.it"
        },
        "TipoBilancio": {
          "type": "string",
          "enum": ["Civilistico", "Consolidato"],
          "example": "Civilistico"
        },
        "PrincipiDiRiferimento": {
          "type": "string",
          "enum": ["IFRS", "ITA GAAP"],
          "example": "IFRS"
        },
        "PrincipiDiRevisione": {
          "type": "string",
          "enum": ["ISA", "ISA Italia"],
          "example": "ISA"
        },
        "TipoIncarico": {
          "type": "string",
          "enum": ["Incarico di legge", "Volontario"],
          "example": "Incarico di legge"
        },
        "TipoEmissione": {
          "type": "string",
          "enum": ["OPINION", "DRAFT"],
          "example": "DRAFT"
        },
        "SocietaQuotata": {
          "type": "string",
          "enum": ["EU REG", "Non quotata"],
          "example": "EU REG"
        },
        "KeyAuditMatters": {
          "type": "string",
          "example": "SI 2"
        },
        "KamNuove": {
          "type": "string",
          "enum": ["SI", "NO"],
          "example": "SI"
        },
        "BilancioAbbreviato": {
          "type": "string",
          "enum": ["SI", "NO"],
          "example": "NO"
        },
        "IncaricoTerzoSettore": {
          "type": "string",
          "enum": ["SI", "NO"],
          "example": "NO"
        },
        "RichiamiDiInformativa": {
          "type": "string",
          "enum": ["SI", "NO"],
          "example": "SI"
        },
        "RichiamoContinuita": {
          "type": "string",
          "enum": ["INCERTEZZE", "NO"],
          "example": "INCERTEZZE"
        },
        "PresentiLimitazioni": {
          "type": "string",
          "enum": ["SI", "NO"],
          "example": "NO"
        },
        "PresentiEccezioni": {
          "type": "string",
          "enum": ["SI", "NO"],
          "example": "NO"
        },
        "TipoOpinion": {
          "type": "string",
          "enum": ["CLEAN", "CON RILIEVI"],
          "example": "CLEAN"
        }
      }
    },
    "MetadataUpdateResponse": {
      "type": "object",
      "properties": {
        "FileLeafRef": {
          "type": "string",
          "example": "Minuta_Meeting_20260313.docx"
        },
        "GMDMID": {
          "type": "string",
          "example": "G0001112223"
        },
        "FY": {
          "type": "string",
          "example": "2026"
        },
        "Modified": {
          "type": "string",
          "format": "date-time",
          "example": "2026-04-24T13:09:19Z"
        }
      }
    },
    "TicketCreateRequest": {
      "type": "object",
      "properties": {
        "fields": {
          "type": "object",
          "properties": {
            "Title": {
              "type": "string",
              "example": "Widget"
            },
            "Requestor": {
              "type": "string",
              "example": "requestor@deloitte.it"
            },
            "RequestType": {
              "type": "string",
              "example": "Text"
            },
            "GMDMID": {
              "type": "string",
              "example": "G0001112223"
            },
            "FY": {
              "type": "string",
              "example": "2026"
            },
            "OpportunityID": {
              "type": "string",
              "example": "OPP-012345"
            },
            "EngManager": {
              "type": "string",
              "example": "manager@deloitte.it"
            },
            "EngPartner": {
              "type": "string",
              "example": "partner@deloitte.it"
            }
          }
        }
      }
    },
    "TicketCreateResponse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "1"
        },
        "createdDateTime": {
          "type": "string",
          "format": "date-time",
          "example": "2026-04-24T14:18:25Z"
        },
        "webUrl": {
          "type": "string",
          "example": "https://resources.deloitte.com/sites/DOL-c-IT-AeA-NpdTools/toolopinion/Lists/AssistantTickets/1_.000"
        }
      }
    }
  }
}
