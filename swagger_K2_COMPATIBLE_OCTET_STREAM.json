              "$ref": "#/definitions/MetadataUpdateResponse"
            }
          },
          "400": {
            "description": "Invalid metadata or request parameters"
          },
          "401": {
            "description": "Unauthorized - invalid or expired token"
          },
          "404": {
            "description": "Drive item not found"
          }
        }
      }
    },
    "/drives/b!sSUAtvCgMUm0BFEnFxD3h0sY36Mn1aJLiFrVVaoXUhIzGqL5TbOMQ6oDs5ryvI_X/items/{driveItemId}": {
      "delete": {
        "tags": [
          "DraftArea"
        ],
        "summary": "Delete Document from DraftArea Library",
        "description": "Delete a document file from the DraftArea library",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "driveItemId",
            "in": "path",
            "description": "Drive Item ID of the file to delete",
            "required": true,
            "type": "string"
          },
          {
            "name": "Authorization",
            "in": "header",
            "description": "Bearer token from OAuth 2.0 token endpoint",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "204": {
            "description": "File deleted successfully (no content)"
          },
          "401": {
            "description": "Unauthorized - invalid or expired token"
          },
          "404": {
            "description": "Drive item not found"
          }
        }
      }
    },
    "/drives/b!sSUAtvCgMUm0BFEnFxD3h0sY36Mn1aJLiFrVVaoXUhJQzYnyN30XRrhXWAL8pDob/items/{driveItemId}": {
      "delete": {
        "tags": [
          "Opinion"
        ],
        "summary": "Delete Document from Opinion Library",
